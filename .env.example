APP_URL=

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only

# --- Twilio: leave empty until the app is finished; app runs in mock mode ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=            # E.164, e.g. +15551234567
TWILIO_MESSAGING_SERVICE_SID=   # optional, MG..., preferred for 10DLC
DEFAULT_COUNTRY_CODE=1

# --- Cron ---
CRON_SECRET=                    # random string, protects /api/cron/*

# --- Web Push ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rubyorbit.com

# --- RubyOrbit integration (phase 9) ---
RUBYORBIT_API_KEYS=             # comma-separated keys
