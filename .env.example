APP_URL=

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only

# --- Telnyx: leave empty to run in mock mode (messages are stored but not sent) ---
TELNYX_API_KEY=                 # Mission Control -> API Keys (starts with KEY)
TELNYX_PUBLIC_KEY=              # Mission Control -> Keys & Credentials -> Public Key (verifies webhooks)
TELNYX_PHONE_NUMBER=            # E.164, e.g. +15551234567
TELNYX_MESSAGING_PROFILE_ID=    # Messaging profile UUID the number is assigned to
DEFAULT_COUNTRY_CODE=1

# --- Cron ---
CRON_SECRET=                    # random string, protects /api/cron/*

# --- Web Push ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rubyorbit.com

# --- RubyOrbit integration (phase 9) ---
RUBYORBIT_API_KEYS=             # comma-separated keys
